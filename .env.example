# Variáveis de ambiente do repasse. Só os nomes: valores reais nunca entram no Git.
# Origem de cada valor e onde cadastrar: docs/ambiente.md
# Copie para .env.local (ignorado pelo Git) e preencha.

# --- Públicas: vão para o navegador ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Somente servidor: nunca com o prefixo NEXT_PUBLIC_ ---
SUPABASE_SECRET_KEY=

# --- Ferramentas locais de banco (migrações e testes); não vão para a Vercel ---
SUPABASE_PROJECT_REF=
SUPABASE_DB_URL=
